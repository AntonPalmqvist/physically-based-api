{
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "header", "data"],
  "properties": {
    "$schema": { "type": "string" },
    "header": { "$ref": "./header.json" },
    "data": {
      "description": "An array of Lens objects.",
      "type": "array",
      "items": {
        "title": "Lens",
        "description": "Any type of lens that is being used, or simulated, in any way in CG productions (including games).",
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "make": {
            "description": "Brand name.",
            "type": "string",
            "example": "Cooke"
          },
          "model": {
            "description": "Model name.",
            "type": "string",
            "example": "Varotal/i"
          },
          "variants": {
            "description": "Lists all different variations of the lens. If the lens only comes in one variant, just specify that one single variant.",
            "type": "array",
            "minItems": 1,
            "items": {
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "format": {
                  "description": "Format.",
                  "type": "string",
                  "example": "FF 30-95mm"
                },
                "focalLength": {
                  "description": "Min and max focal length in millimeters. If it's a prime lens, only set one value.",
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "example": [30, 95],
                  "minItems": 1,
                  "maxItems": 2
                },
                "aperture": {
                  "description": "Max and min aperture size.",
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "example": [2.9, 22],
                  "minItems": 2,
                  "maxItems": 2
                },
                "blades": {
                  "description": "Number of diaphragm blades.",
                  "type": "integer",
                  "example": 9
                },
                "closeFocus": {
                  "description": "Shortest distance from the sensor to the subject that the lens can achieve focus. Specified in centimeters.",
                  "type": "number",
                  "example": 80
                },
                "squeezeFactor": {
                  "description": "The squeeze factor of an anamorphic lens.",
                  "type": "number",
                  "example": 1.8
                },
                "description": { "$ref": "./description.json" }
              },
              "required": ["format", "focalLength", "aperture", "blades"]
            }
          },
          "description": { "$ref": "./description.json" },
          "tags": { "$ref": "./tag.json" },
          "references": { "$ref": "./reference.json" }
        },
        "required": ["make", "model", "variants", "references"]
      }
    }
  },
  "examples": [
    {
      "$schema": "../../schemas/components/schemas/Lens.json",
      "header": {
        "schemaVersion": 2.1,
        "updated": 202603101230,
        "license": "CC0 1.0 Universal",
        "origin": "https://api.physicallybased.info/v2/lenses",
        "deprecated": false
      },
      "data": [
        {
          "make": "Cooke",
          "model": "Varotal/i",
          "variants": [
            {
              "format": "FF 19-40mm",
              "focalLength": [19, 40],
              "aperture": [2.9, 22],
              "blades": 9,
              "closeFocus": 60
            },
            {
              "format": "FF 30-95mm",
              "focalLength": [30, 95],
              "aperture": [2.9, 22],
              "blades": 9,
              "closeFocus": 80
            },
            {
              "format": "FF 85-215mm",
              "focalLength": [85, 215],
              "aperture": [2.9, 22],
              "blades": 9,
              "closeFocus": 150
            }
          ],
          "references": [
            {
              "title": "Cooke Varotal/i FF",
              "publisher": "Cooke Optics Limited",
              "url": "https://cookeoptics.com/lens/varotal-i-ff/",
              "accessed": "2026-01-10"
            }
          ],
          "tags": ["zoom"]
        }
      ]
    }
  ]
}
