{
  "name": "physically-based-api",
  "private": true,
  "description": "Physically Based API",
  "type": "module",
  "scripts": {
    "http": "http-server -o deploy",
    "http-v2": "http-server -o deploy/v2",
    "image-processor": "node scripts/image-processor.mjs",
    "create-materialx": "node scripts/create-materialx.mjs",
    "create-usd": "node scripts/create-usd.mjs",
    "prepare": "husky",
    "redocly-bundle": "redocly bundle schemas/components/schemas/Root.json -o schemas/openapi-schema-v2.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntonPalmqvist/physically-based-api.git"
  },
  "author": "Anton Palmqvist",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/AntonPalmqvist/physically-based-api/issues"
  },
  "homepage": "https://api.physicallybased.info/",
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@redocly/cli": "^2.47.0",
    "@scalar/api-reference": "^1.66.1",
    "adm-zip": "^0.5.18",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "sharp": "^0.35.3"
  },
  "lint-staged": {
    "./deploy/v2/{cameras,materials,lightsources,lenses}.json": [
      "node scripts/pre-commit.mjs --staged"
    ]
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "core-js@3.49.0": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.4": true
  }
}
